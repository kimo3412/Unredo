# Logs
*.log
logs/

# Plan files generated by unredo
# Plans may contain sensitive row data; default to local only.
# Uncomment the following lines to keep plans out of git:
# *.undo.json
# *.redo.json
# *.resolved.json

# Test data lives under testdata/; committed plans there are documentation
# only and never contain real customer data.
!testdata/plans/

# Local Unredo config overrides
unredo.local.yaml
unredo.local.yml
